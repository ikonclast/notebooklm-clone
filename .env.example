# ============================================================
#  NotebookLM Clone — Stack-Konfiguration (docker compose)
#  Optional. Ohne .env läuft der Stack vollständig lokal mit Ollama.
#  Zum Anpassen:  cp .env.example .env
# ============================================================

# --- LLM Provider -------------------------------------------
# WICHTIG — DSGVO:
#   ollama  → vollständig lokal, kein Byte verlässt die Infrastruktur (Default)
#   groq    → Dokumenteninhalt wird auf US-Servern verarbeitet (AVV erforderlich)
#   openai  → Dokumenteninhalt wird auf US-Servern verarbeitet (AVV erforderlich)
LLM_PROVIDER=ollama

# Lokales Modell (wird beim ersten `docker compose up` automatisch gezogen).
OLLAMA_MODEL=llama3.2:3b

# Nur nötig, wenn LLM_PROVIDER=groq:
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Nur nötig, wenn LLM_PROVIDER=openai:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Retrieval / Limits -------------------------------------
# Bester Retrieval-Score unter diesem Wert → kein LLM-Call ("nicht gefunden").
CONFIDENCE_THRESHOLD=0.3
TOP_K=5
MAX_FILE_SIZE_MB=20
