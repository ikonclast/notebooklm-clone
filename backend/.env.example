# ============================================================
#  NotebookLM Clone — Backend-Konfiguration
#  Kopiere diese Datei nach .env und passe die Werte an.
# ============================================================

# --- LLM Provider -------------------------------------------
# WICHTIG — DSGVO:
#   ollama  → vollständig lokal, kein Byte verlässt die Infrastruktur (Default)
#   groq    → Dokumenteninhalt wird auf US-Servern verarbeitet (AVV erforderlich)
#   openai  → Dokumenteninhalt wird auf US-Servern verarbeitet (AVV erforderlich)
LLM_PROVIDER=ollama

# Nur nötig bei LLM_PROVIDER=groq bzw. openai:
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (lokal, Default) — lokales Ollama braucht KEINEN Key:
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
# Nur für Ollama Cloud/Turbo:
OLLAMA_API_KEY=

# --- Retrieval ----------------------------------------------
# Bester Retrieval-Score unter diesem Wert → kein LLM-Call ("nicht gefunden").
CONFIDENCE_THRESHOLD=0.3
TOP_K=5

# --- Upload / Chunking --------------------------------------
MAX_FILE_SIZE_MB=20
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_PERCENT=0.15

# --- Persistenz-Pfade ---------------------------------------
# OHNE Docker: leer lassen → Default ist backend/data/ (persistent, im Repo
#   gitignored). NICHT /tmp verwenden (flüchtig, beim Reboot weg).
# MIT Docker: docker-compose.yml setzt diese auf /data/* (gemountete Volumes) —
#   hier nichts eintragen.
# UPLOAD_DIR=./data/uploads
# CHROMA_PATH=./data/chroma
# AUDIT_LOG_PATH=./data/audit.jsonl

# --- CORS ---------------------------------------------------
# JSON-Array der erlaubten Frontend-Origins.
CORS_ORIGINS=["http://localhost:3000"]
